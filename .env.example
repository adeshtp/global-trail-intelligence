CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development

CESIUM_ION_TOKEN=
GEMINI_API_KEY=
# Optional alias, used only when GEMINI_API_KEY is empty.
LLM_API_KEY=
TAVILY_API_KEY=

POSTPASS_URL=https://postpass.geofabrik.de/api/interpreter
POSTPASS_TIMEOUT_SECONDS=30
POSTPASS_CACHE_TTL_SECONDS=300
# Bounded transport-level retries. A persistent outage is never masked.
POSTPASS_RETRIES=1
# Postpass is a free public mirror and has been observed answering HTTP 503
# for short stretches under load. These bound a retry for that transient
# server-side condition only; client errors are never retried.
POSTPASS_SERVER_RETRIES=2
POSTPASS_SERVER_BACKOFF_SECONDS=1.5
# Overpass API fallback for real OSM identity/geometry. Engaged only when a
# Postpass query fails outright; a successful Postpass answer (even an empty
# one) is never re-queried.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=200
OVERPASS_CACHE_TTL_SECONDS=300
OVERPASS_CACHE_MAX_ENTRIES=128
OVERPASS_429_BACKOFF_SECONDS=6
AREA_RELATION_ROW_LIMIT=500
AREA_WAY_ROW_LIMIT=5000
# Bounded concurrency for Postpass lookups (provider-friendly limits).
AGENT_RESOLUTION_CONCURRENCY=4
NAME_RESOLUTION_CONCURRENCY=3
# Large-area tiling. Areas wider than MAX_TILE_SPAN_DEG are split into a
# uniform deterministic grid so coverage stays complete and bounded. The grid
# is a partition, not a sample, and skipped tiles are reported to the client.
MAX_TILE_SPAN_DEG=0.75
MAX_DISCOVERY_TILES=40
TILE_CONCURRENCY=3
# The longest a search may keep starting new provider queries. Past it, no new
# tile is queried and no capped tile is split further; what was skipped or cut
# is reported in the response coverage and the results found so far are returned.
DISCOVERY_TIME_BUDGET_SECONDS=60
# Weak-evidence acceptance thresholds for locally-named paths. These affect
# relevance only: accepted geometry is always real and Postpass-verified.
MIN_LOCAL_PATH_KM=0.30
MIN_LOCAL_PATH_STRONG_KM=1.50
SEARXNG_URL=http://127.0.0.1:8080/search
SEARXNG_TIMEOUT_SECONDS=12
SEARXNG_SEARCH_QUERIES=2
TRAIL_DISCOVERY_GEMINI_MODEL=gemini-3.5-flash-lite
# Bound on the Gemini extraction call. On timeout the search falls back to
# deterministic candidates instead of waiting.
GEMINI_TIMEOUT_SECONDS=30

# Leave blank to use the repository model path.
DIFFICULTY_MODEL_PATH=
